  "homepage": "https://ruv.io",
  "repository": { "type": "git", "url": "git+https://github.com/ruvnet/ai-text-watermark.git", "directory": "packages/stream-reformat" },
  "bugs": { "url": "https://github.com/ruvnet/ai-text-watermark/issues" },
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "require": "./index.js" },
