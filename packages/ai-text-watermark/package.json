{
  "name": "ai-text-watermark",
  "version": "0.3.0",
  "description": "Invisible, key-verifiable watermarks for AI/LLM text (SynthID-Text style) in Rust + WebAssembly. Generate, detect, embed a secret provenance message, and run an ultra-low-latency decode-loop proxy — Node and browser. Standalone wrapper around @claude-flow/watermark.",
  "keywords": ["ai-text-watermark","llm-watermark","synthid","synthid-text","ai-content-detection","ai-provenance","eu-ai-act","text-watermark","wasm","distortion-free-watermark","gumbel-watermark","content-credentials"],
  "license": "MIT",
  "author": "rUv (https://github.com/ruvnet)",
  "homepage": "https://ruvnet.github.io/ai-text-watermark/",
  "repository": { "type": "git", "url": "git+https://github.com/ruvnet/ai-text-watermark.git" },
  "bugs": { "url": "https://github.com/ruvnet/ai-text-watermark/issues" },
  "type": "commonjs",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs", "require": "./index.js" },
    "./web": { "types": "./web.d.ts", "import": "./web.mjs" },
    "./package.json": "./package.json"
  },
  "files": ["index.js","index.mjs","index.d.ts","web.mjs","web.d.ts","README.md"],
  "dependencies": { "@claude-flow/watermark": "^0.3.0" }
}
